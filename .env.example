# --- core ---
AMB_DATABASE_URL=sqlite:///./amb.db
AMB_ENV=dev

# --- governance ---
# How many independent governance reviewers must approve a task.
AMB_QUORUM_SIZE=3
AMB_QUORUM_THRESHOLD=2
# Risk tiers at or above this require a named human co-signer.
AMB_HUMAN_SIGNOFF_TIER=high

# --- LLM governance reviewers (optional; falls back to policy-only review) ---
ANTHROPIC_API_KEY=
AMB_REVIEWER_MODEL=claude-opus-5
AMB_REVIEWER_EFFORT=high

# --- economics ---
AMB_TREASURY_SHARE_BPS=1000   # 10% of paid task value funds the commons treasury
